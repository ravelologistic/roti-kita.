<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="theme-color" content="#102b50"><meta name="description" content="Roti Kita - Roti lezat, harga bersahabat. Hangat dan istimewa untuk keluarga."><title>Roti Kita | Hangat & Istimewa</title><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800;900&display=swap" rel="stylesheet"><script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script><style>
:root{--navy:#102b50;--navy2:#183d68;--gold:#f6bd2d;--gold2:#ffe29a;--cream:#fff7e8;--cream2:#f7ead0;--brown:#54290f;--ink:#2c2119;--muted:#776b60;--white:#fff;--green:#237a54;--red:#b53b35;--shadow:0 16px 40px #39220f18}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:100px}body{margin:0;background:var(--cream);color:var(--ink);font-family:"DM Sans",Arial,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.container{width:min(1180px,92%);margin:auto}.topbar{position:sticky;top:0;z-index:20;background:#fff8e9ed;backdrop-filter:blur(14px);border-bottom:3px solid var(--gold);box-shadow:0 5px 22px #29160712}.navwrap{min-height:92px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--brown);min-width:210px}.brand img{width:82px;height:76px;object-fit:contain}.brand strong{font:900 27px "Playfair Display",serif;letter-spacing:.5px}.brand small{display:block;color:#96743a;letter-spacing:4px;font-size:10px;margin-top:4px}.navlinks{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.navlinks a{padding:12px 15px;text-decoration:none;color:#442815;font-weight:800;border-radius:30px}.navlinks a:hover,.navlinks a.active{background:var(--gold);box-shadow:0 5px 12px #bd841d35}.nav-cta,.btn{border:0;border-radius:30px;padding:13px 21px;font-weight:800;background:var(--gold);color:#40230d;box-shadow:0 7px 18px #9c671e2b}.btn.dark{background:var(--brown);color:white}.btn.blue{background:var(--navy);color:white}.btn.light{background:#fff0c9}.btn.danger{background:#ffe0dc;color:#9a2923}.btn:disabled{opacity:.55;cursor:not-allowed}.menu-toggle{display:none;border:0;background:var(--navy);color:#fff;border-radius:12px;padding:10px 13px;font-size:20px}
.hero{position:relative;overflow:hidden;background:linear-gradient(105deg,#fff0ce 0%,#fff6e3 48%,#d59a55 100%);min-height:475px;border-bottom:8px solid var(--gold);display:flex;align-items:center}.hero:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% 20%,#fff8 0 5%,transparent 35%),radial-gradient(circle at 8% 90%,#f5c65a55,transparent 28%)}.hero-grid{position:relative;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:25px;padding:52px 0}.eyebrow{display:inline-flex;align-items:center;gap:8px;background:#ffdf8b;color:#6c390f;padding:8px 15px;border-radius:30px;font-size:12px;font-weight:900;letter-spacing:1.3px}.hero h1{font:900 clamp(48px,7vw,82px)/.98 "Playfair Display",serif;color:#54290f;margin:20px 0 12px;text-shadow:0 3px 0 #fff8}.hero h2{font:800 clamp(22px,3vw,34px) "Playfair Display",serif;color:#5b2e12;margin:0 0 18px}.hero p{font-size:18px;line-height:1.7;color:#684c34;max-width:560px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}.hero-visual{min-height:350px;display:grid;place-items:center;position:relative}.hero-package{transform:rotate(4deg) scale(1.12);filter:drop-shadow(0 22px 18px #4a2b1740)}.hero-note{position:absolute;right:0;bottom:18px;background:#fff8e9;padding:13px 18px;border-radius:18px;color:var(--brown);font-weight:800;box-shadow:var(--shadow)}
.section{padding:76px 0}.section-head{text-align:center;margin-bottom:35px}.section-head .eyebrow{margin-bottom:12px}.section-head h2{font:900 clamp(32px,5vw,48px) "Playfair Display",serif;color:var(--navy);margin:8px 0}.section-head p{color:var(--muted);font-size:17px;margin:8px auto;max-width:650px}.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.product-card{background:#fffaf0;border:1px solid #ecd9b9;border-radius:24px;overflow:hidden;box-shadow:var(--shadow);transition:.25s}.product-card:hover{transform:translateY(-7px);box-shadow:0 22px 45px #39220f25}.product-art{height:260px;background:linear-gradient(145deg,#fff4dc,#f3dfbc);display:grid;place-items:center;position:relative;overflow:hidden}.product-art:before{content:"";position:absolute;width:230px;height:230px;border-radius:50%;background:#fff9;filter:blur(1px)}.product-info{padding:20px 22px 23px}.product-info h3{font:800 23px "Playfair Display",serif;color:var(--brown);margin:0 0 7px}.product-info p{color:#746456;line-height:1.55;min-height:48px;margin:0 0 14px}.price{font-size:25px;font-weight:900;color:var(--navy)}.product-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:15px}
.package{width:170px;height:225px;position:relative;border:3px solid #ffffffd9;border-radius:23px 23px 30px 30px;background:linear-gradient(100deg,#ffffff9c,#ffffff24 25%,#fff9 52%,#ffffff24 80%,#fff9);box-shadow:inset 0 0 0 2px #d8d1c5,0 14px 20px #6b47272c;overflow:hidden;display:flex;align-items:center;flex-direction:column;padding-top:16px}.package:before,.package:after{content:"";position:absolute;top:0;bottom:0;width:9px;background:#ffffff70}.package:before{left:5px}.package:after{right:5px}.bread{position:relative;z-index:1;margin-top:12px;background:linear-gradient(145deg,#ffd77b,#d8892e 65%,#a95016);box-shadow:inset -8px -9px 0 #a85c1d33, inset 0 5px 0 #fff6,0 9px 13px #61330f38}.bread.small{width:91px;height:68px;border-radius:48% 48% 42% 42%;margin-top:27px}.bread.medium{width:112px;height:76px;border-radius:55% 45% 42% 42%;transform:rotate(-8deg);margin-top:21px}.bread.large{width:125px;height:91px;border-radius:50% 50% 38% 38%;margin-top:12px}.bread.filled:after{content:"";position:absolute;left:22%;right:22%;bottom:-3px;height:14px;border-radius:50%;background:#7b3518;opacity:.55}.bread.topping:before{content:"";position:absolute;inset:13px 20px;background:radial-gradient(circle,#6d3218 0 3px,transparent 4px) 0 0/19px 16px,radial-gradient(circle,#fff0c4 0 2px,transparent 3px) 8px 7px/19px 16px}.pack-logo{position:relative;z-index:2;width:116px;height:68px;object-fit:contain;margin-top:-1px;filter:drop-shadow(0 3px 2px #32170755)}.pack-ribbon{position:absolute;z-index:3;bottom:53px;left:-7px;right:-7px;height:35px;background:linear-gradient(100deg,#0d2c62,#174b91,#0b2454);border-top:4px solid var(--gold);border-bottom:3px solid #d7a52d;transform:rotate(-2deg);display:grid;place-items:center;color:#fff0b4;font-weight:900;font-size:12px;letter-spacing:1px}.pack-price{position:absolute;bottom:8px;z-index:4;color:#ffe18a;font-size:17px;font-weight:900;text-shadow:0 2px 3px #071b3c}.features{display:grid;grid-template-columns:repeat(4,1fr);gap:0;background:#ffedc9;border-radius:20px;margin-top:35px;box-shadow:var(--shadow);overflow:hidden}.feature{text-align:center;padding:22px 10px;font-weight:800;color:#58300f;border-right:1px solid #c99c5d}.feature:last-child{border:0}.feature span{display:block;font-size:27px;margin-bottom:5px}
.about-band{background:var(--navy);color:white;border-radius:30px;padding:42px;display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:center}.about-band h2{font:900 35px "Playfair Display",serif;color:var(--gold2);margin:0 0 12px}.about-band p{line-height:1.8;color:#e6edf7}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.contact-card{background:var(--navy);color:white;padding:28px;border-radius:22px}.contact-card h3{color:var(--gold2);font-size:21px;margin:0 0 10px}.contact-card a{color:#ffdc79;font-weight:800;text-decoration:none;overflow-wrap:anywhere}.contact-card p{color:#e8edf5}
.form-card,.panel-card{background:white;border:1px solid #eadfcf;border-radius:22px;padding:26px;box-shadow:var(--shadow)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.field{display:flex;flex-direction:column;gap:7px}.field.full{grid-column:1/-1}.field label{font-weight:800;color:#49301e}.field input,.field select,.field textarea{width:100%;border:1px solid #d8d1c7;border-radius:12px;padding:13px 14px;background:#fffdf9;color:#30251c;outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:#d89c24;box-shadow:0 0 0 3px #f6bd2d2b}.hint{font-size:13px;color:#76695d;line-height:1.5}.order-line{display:grid;grid-template-columns:1fr 110px;gap:10px;align-items:end;padding:12px 0;border-bottom:1px dashed #e5d6c2}.total-box{display:flex;justify-content:space-between;align-items:center;background:#fff2d2;border-radius:14px;padding:16px;margin:18px 0;font-weight:900;color:var(--brown)}.notice{padding:13px 15px;border-radius:12px;background:#fff2d2;color:#69430d;margin:12px 0}.success{background:#e5f6ed;color:#17623d}.error{background:#ffe9e6;color:#922f27}.track-result{margin-top:20px}.timeline{border-left:3px solid var(--gold);padding-left:20px;margin:15px 0}.timeline-item{position:relative;padding:0 0 17px}.timeline-item:before{content:"";position:absolute;left:-27px;top:4px;width:11px;height:11px;background:var(--gold);border:3px solid white;border-radius:50%;box-shadow:0 0 0 1px #c28b24}.hidden{display:none!important}
.admin-wrap{background:#f2f5f9;min-height:100vh;padding:35px 0}.admin-shell{display:grid;grid-template-columns:245px 1fr;gap:22px}.admin-side{background:var(--navy);border-radius:22px;padding:22px;color:white;height:max-content;position:sticky;top:110px}.admin-side img{width:115px;height:90px;object-fit:contain;display:block;margin:0 auto 8px}.admin-side h3{text-align:center;color:var(--gold2);margin:0 0 20px}.admin-nav{display:grid;gap:8px}.admin-nav button{border:0;text-align:left;padding:12px;border-radius:11px;background:transparent;color:#e9eff8;font-weight:700}.admin-nav button.active,.admin-nav button:hover{background:var(--gold);color:#44260d}.admin-main{min-width:0}.admin-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px}.admin-head h2{font:900 30px "Playfair Display",serif;color:var(--navy);margin:0}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:20px}.stat{background:white;border-radius:17px;padding:19px;box-shadow:var(--shadow);border-top:4px solid var(--gold)}.stat small{color:#756b61;font-weight:700}.stat strong{display:block;font-size:28px;color:var(--navy);margin-top:7px}.admin-section{display:none}.admin-section.active{display:block}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:650px}th,td{padding:12px 11px;border-bottom:1px solid #eee5d9;text-align:left;font-size:13px}th{background:#fff4dc;color:#56300f;white-space:nowrap}td select{padding:7px;border:1px solid #ddd;border-radius:8px}.actions{display:flex;gap:6px;flex-wrap:wrap}.actions .btn{padding:7px 10px;font-size:12px}.login-box{max-width:440px;margin:25px auto}.muted{color:#7b7168}.footer{background:#43210f;color:#ffe8b2;padding:35px 0;margin-top:60px;text-align:center;border-top:7px solid var(--gold)}.footer img{width:100px;height:75px;object-fit:contain}.footer p{margin:6px}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);z-index:99;background:#173b62;color:white;padding:13px 19px;border-radius:12px;box-shadow:var(--shadow);max-width:90%;text-align:center}
@media(max-width:850px){.navwrap{min-height:78px;flex-wrap:wrap;padding:8px 0}.brand img{width:65px;height:60px}.brand strong{font-size:22px}.menu-toggle{display:block}.navlinks{display:none;width:100%;padding:0 0 12px;flex-direction:column;align-items:stretch}.navlinks.open{display:flex}.navlinks a{text-align:center}.nav-cta{display:none}.hero-grid{grid-template-columns:1fr;text-align:center;padding:42px 0}.hero p{margin:auto}.hero-actions{justify-content:center}.hero-visual{min-height:300px}.hero-package{transform:scale(.95)}.product-grid{grid-template-columns:1fr 1fr}.about-band{grid-template-columns:1fr}.admin-shell{grid-template-columns:1fr}.admin-side{position:static}.admin-nav{grid-template-columns:repeat(3,1fr)}.admin-nav button{text-align:center;font-size:12px}.stats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.section{padding:55px 0}.product-grid{grid-template-columns:1fr}.product-art{height:245px}.features{grid-template-columns:1fr 1fr}.feature:nth-child(2){border-right:0}.feature:nth-child(-n+2){border-bottom:1px solid #c99c5d}.form-grid,.contact-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.form-card,.panel-card{padding:18px}.about-band{padding:27px}.stats{gap:9px}.stat{padding:14px}.stat strong{font-size:23px}.admin-nav{grid-template-columns:repeat(2,1fr)}.admin-head{align-items:flex-start;flex-direction:column}.hero h1{font-size:52px}.hero-visual{min-height:270px}.package{transform:scale(.92)}}

/* Kemasan foto sesuai contoh Roti Kita */
.package{width:178px!important;height:220px!important;background-image:url("data:image/webp;base64,")!important;background-position:center!important;background-repeat:no-repeat!important;background-size:100% 100%!important;border:0!important;border-radius:12px!important;box-shadow:none!important;padding:0!important;}
.package>*{display:none!important}
.package:before,.package:after{display:none!important}
.hero-package .package{width:245px!important;height:270px!important}
.product-art .package{width:190px!important;height:205px!important}
.brand img{object-fit:contain!important}

/* Foto kemasan produk: setiap varian memiliki ukuran, topping, dan harga sendiri */
#produk .product-art{padding:8px;background:linear-gradient(145deg,#fff4dc,#f3dfbc)}
#produk .product-art:before{content:none}
#produk .product-photo{position:relative;z-index:1;width:100%;height:100%;object-fit:contain;display:block}

/* Animasi premium: floating bertingkat, kilau lembut, dan interaksi hover */
.hero-visual.hero-products{position:relative;isolation:isolate;display:flex;align-items:flex-end;justify-content:center;gap:clamp(3px,1.2vw,16px);min-height:370px;padding:12px 0 54px;}
.hero-visual.hero-products:before{content:"";position:absolute;z-index:-1;left:10%;right:5%;bottom:25px;height:42%;border-radius:50%;background:radial-gradient(ellipse at center,#fff8df 0%,#f8d58b55 48%,transparent 74%);filter:blur(13px);animation:rotiGlow 5s ease-in-out infinite;}
.hero-product{position:relative;z-index:1;display:block;object-fit:contain;height:auto;filter:drop-shadow(0 18px 15px #4a2b1738);transform-origin:50% 85%;will-change:transform,filter;backface-visibility:hidden;animation:rotiFloat 5.2s cubic-bezier(.45,0,.55,1) infinite;transition:filter .45s ease;}
.hero-product-one{width:27%;max-width:180px;animation-delay:-1.2s;}
.hero-product-two{width:31%;max-width:210px;animation-delay:-3.1s;}
.hero-product-three{width:35%;max-width:235px;animation-delay:-2.1s;}
.hero-product:hover{filter:drop-shadow(0 25px 22px #8a551b55) brightness(1.045);animation-play-state:paused;}
.hero-products .hero-note{right:2%;bottom:0;z-index:2;}
@keyframes rotiFloat{0%,100%{transform:translate3d(0,0,0) rotate(0deg) scale(1)}24%{transform:translate3d(0,-7px,0) rotate(-.65deg) scale(1.008)}52%{transform:translate3d(0,-17px,0) rotate(.45deg) scale(1.018)}78%{transform:translate3d(0,-5px,0) rotate(.15deg) scale(1.006)}}
@keyframes rotiGlow{0%,100%{opacity:.48;transform:scale(.94)}50%{opacity:.9;transform:scale(1.06)}}
@media(max-width:850px){.hero-visual.hero-products{min-height:285px;padding:8px 0 48px;gap:3px}.hero-product-one{width:29%}.hero-product-two{width:33%}.hero-product-three{width:36%}.hero-products .hero-note{right:50%;transform:translateX(50%);white-space:nowrap;font-size:12px;padding:9px 13px}}
@media(max-width:420px){.hero-visual.hero-products{min-height:225px;padding-bottom:43px}.hero-product-one{width:30%}.hero-product-two{width:34%}.hero-product-three{width:37%}}
@media(prefers-reduced-motion:reduce){.hero-product,.hero-visual.hero-products:before{animation:none;will-change:auto}.hero-product:hover{transform:none}}
</style></head><body><div id="customerPage"><!-- NAVIGASI --><header class="topbar"><div class="container navwrap"><a class="brand" href="#beranda"><img src="data:image/webp;base64," alt="Logo Roti Kita"><div><strong>ROTI KITA</strong><small>HANGAT & ISTIMEWA</small></div></a><button class="menu-toggle" onclick="toggleMenu()">☰</button><nav class="navlinks" id="navLinks"><a href="#beranda" onclick="closeMenu()">Beranda</a><a href="#produk" onclick="closeMenu()">Produk</a><a href="#pemesanan" onclick="closeMenu()">Pemesanan</a><a href="#pelacakan" onclick="closeMenu()">Lacak Pesanan</a><a href="#tentang" onclick="closeMenu()">Tentang Kami</a><a href="#kontak" onclick="closeMenu()">Kontak</a><a href="#admin" onclick="closeMenu();showSitePage('admin')">Admin</a></nav><a href="#pemesanan" class="nav-cta">Pesan Sekarang</a></div></header><!-- BERANDA --><section class="hero" id="beranda"><div class="container hero-grid"><div><span class="eyebrow">✦ ROTI KITA • HANGAT & ISTIMEWA</span><h1>ROTI KITA</h1><h2>Roti Lezat, Harga Bersahabat!</h2><p>
        Nikmati pilihan roti dengan berbagai ukuran dan rasa.
        Dibuat untuk menemani waktu santai dan kebersamaan
        bersama keluarga.
      </p><div class="hero-actions"><a href="#produk" class="btn dark">Lihat Produk</a><a href="#pemesanan" class="btn">Mulai Pemesanan</a></div></div><div class="hero-visual hero-products">
  <img class="hero-product hero-product-one" src="data:image/webp;base64,
